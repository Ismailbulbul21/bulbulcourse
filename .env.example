# ── Frontend (safe to expose in the browser) ────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_CONTABO_ENDPOINT=https://eu2.contabostorage.com
VITE_CONTABO_BUCKET=your-bucket-name

# ── Server-side secrets (NEVER put these in the frontend .env) ──────────────
# These are set as Supabase Edge Function secrets, e.g.:
#
#   supabase secrets set CONTABO_ENDPOINT=https://eu2.contabostorage.com \
#     CONTABO_ACCESS_KEY=xxx CONTABO_SECRET_KEY=xxx \
#     CONTABO_TENANT_ID=xxx CONTABO_BUCKET=your-bucket CONTABO_REGION=default \
#     WAAFI_MERCHANT_UID=Mxxxxxxx WAAFI_API_USER_ID=xxxxxxx WAAFI_API_KEY=API-xxxx \
#     --project-ref YOUR_PROJECT_REF
